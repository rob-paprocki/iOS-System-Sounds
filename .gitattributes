# Audio assets are binary -- never diff or line-ending-normalise them.
*.caf  binary
*.m4a  binary
*.aiff binary
*.aif  binary
*.wav  binary
*.voc  binary
*.mp3  binary
*.flac binary

# Keep the generated index out of diff noise and language stats.
sounds.json linguist-generated=true
sounds.csv  linguist-generated=true

# Don't let 5,359 audio files decide the repo's "language".
Current/**          linguist-vendored=true
Removed/**          linguist-vendored=true
Spoken*Content/**    linguist-vendored=true
