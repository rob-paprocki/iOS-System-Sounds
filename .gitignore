# The converted WAV mirror is 1.6 GB -- distributed via Releases, not git.
# Rebuild it locally with: python3 tools/make-wav.py
WAV/

# Ingest scratch: downloaded IPSWs, mounted images, per-version extractions.
# Everything here is reproducible from tools/fetch-version.py.
_work/

# Content-addressed store of every unique audio file across all versions.
# Large, and the Current/ + Removed/ trees are built from it.
_store/

# Build artifacts for the web front end: the AAC preview mirror, the split
# index, the waveform peaks and the prebuilt archives. All regenerable with
# tools/make-web.py, and together larger than the originals they describe.
web/

# Run logs.
_logs/

# Staging directory for release assets, built by tools/make-web.py and
# uploaded with gh release upload. Nothing here belongs in git.
_dist/

# Release archives
*.zip

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Python
__pycache__/
*.pyc
.venv/

# Ingest working state; the public index is sounds.json, rebuilt by tools/build-repo.py
corpus.json

# ipsw writes this next to downloads
checksums.txt.sha1
