;should only appear before noun when "find" verb is used

#SUBSTITUTION
THAT
    that {were|are}

THAT_I
    {that} (i have|i)

IF_I
    if i {have} {any|some|many|a lot of}

ALL_ANY
    all|any

FOR
    for {all {of my}|any|my|the}

#DICT

missed
    missed
    i missed
    have i missed
    did i miss

new
    (new) [exists;node="phoneCallNoun,voiceMailNoun";constraint=after]
    i have(n't| not) (heard|seen|listened to) {yet}[exists;node="phoneCallNoun,voiceMailNoun";constraint=before]

recent
    recently
    {${ALL_ANY}} recent{s}
    my recent
    ${THAT} recent
    ${FOR} recent

last
    just [exists;node=phoneCallVerb;category=find;constraint=start][exists;node=phoneCallNoun;category=call;constraint=adjAfter]
    {the} last [exists;node=phoneCallVerb;category=find;constraint=start][exists;node=phoneCallNoun][saliency=high][conf=vh]
    {the} last [notExists;node=phoneCallVerb;category=redial][exists;node=phoneCallNoun;category=call;constraint=adjAfter][infers;node=phoneCallAttributes;category=received]
    {the} last
    my latest
    {${ALL_ANY}} latest
    {the} most recent
    ${FOR} (recently received|last|most recent)

received
    {${THAT}|${THAT_I}|${IF_I}|all|any|my} received {recently}
    {${THAT}|${THAT_I}|${IF_I}|all|any|my} recently received
    {${THAT}|all|any|my} arrived
    {${THAT_I}|${IF_I}|my} got {any}
    have i gotten
    incoming
    ${FOR} {recently} received
    i (get|receive) [exists="did";constraint=adjBefore]
    me [exists;node=phoneCallVerb;category=find;constraint=start][exists;node=phoneCallNoun;category=call;constraint=adjBefore]
    do I have [exists;node=phoneCallVerb;category=find;constraint=before][exists;node=phoneCallNoun;constraint=adjBefore][exists;node=phoneCallContactRole;category=from;constraint=adjAfter]

outgoing
    {${THAT}|${THAT_I}|${IF_I}|all|any|my} outgoing
    {${THAT}|all|any|my} outgoing
    {${THAT_I}|${IF_I}|my} made {any}
    have i made
    i {last} (call{ed}|phone{d})
    ${FOR} {recent} outgoing
    i make [exists="did";constraint=adjBefore]
    i [exists="did";constraint=adjBefore][exists;node=phoneCallNoun;category=call;constraint=adjAfter]
