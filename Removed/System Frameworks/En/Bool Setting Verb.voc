unspecified [exists;constraint=start][exists;node=boolSettingName][notExists;node="boolSettingState"][infers;node=settingAttribute;category=siriHelp];capabilities?
    ;is ___ supported
    ;are you capable of?
    can (I|you)
    ;set _____ (what did they want to do?)
    ;set [exists;constraint=start][notExists;node=boolSettingState][notExists;node=boolSettingName;category="doNotDisturb"]
    (what|tell me|talk {to me}) about
;    what( is|{'}s) [notExists;node=settingAttribute;category="value"][notExists="setting,settings"][exists;constraint=start][exists;node=boolSettingName;constraint=adjAfter][infers;node=settingAttribute;category=siriHelp][saliency=high][conf=high]
;    what( is|{'}s) [notExists;node=settingAttribute;category="value"][notExists="setting,settings"]
    how( is|{'}s) [exists;constraint=start][exists;node=boolSettingName][notExists;node=settingAttribute;category="value"]
    how do I use [infers;node=settingAttribute;category=featureHelp]

set ;[exists;node=boolSettingName;constraint=after]
    ;set things whose names imply being on or off
    switch to [exists;node=boolSettingName;category="invertColors,monoAudio,appearanceDark,appearanceLight";constraint=after]
    (switch|turn)

    ;avoid collision with scheduling do not disturb using "set" -- ugly, needs work...
    set [d][notExists;node=dateSettingState;constraint=after][exists;node=boolSettingState;constraint=after][conf="high"]
    set [notExists;node=dateSettingState;constraint=after]
    (make|change) [conf="high"]

    ; "show the flashlight" is actually setting a value, rather than navigating to a settings page.
    show {me} {my} [exists;node=boolSettingName;category=flashlight][notExists;node=settingNoun;category=settings][infers;node=boolSettingState;category=on][saliency=high]
    
    ; "Shine the flashlight"
    shine [infers;node=boolSettingState;category=on][exists;node=boolSettingName;category=flashlight]
    open [infers;node=boolSettingState;category=on][exists;node=boolSettingName;category=flashlight]

toggle [exists;node=boolSettingName;constraint=after]
    toggle [d]
    invert [exists;node=boolSettingName;category="invertColors"]
    change [exists;node=boolSettingName;category="appearance"]

read [exists;constraint=start][infers;node=settingAttribute;category="value"]
    ;is ___ on
    is [exists;constraint=start][exists;node=boolSettingState]
    (is|am I|are you|has|have) [exists;constraint=start][exists;node=settingAttribute;category="value"]
    (do|are|am) (I|you|we) (have|using|on) [exists;constraint=start][exists;node=boolSettingState]
    ;what is _____ set to
    what{ is|{'}s| are|'re| about} [exists;node=boolSettingName]
    what( is|{'}s| has) [exists;constraint=start][exists;node=settingAttribute;category="value"]
    ;how is _____ configured
    how{ is|{'}s| has}
    ;tell me if ____ is on
    tell {me}
    do I have
    am I using
    is my [exists;constraint=start]

pair
    (pair|link|connect|set{ }up) [exists;node=boolSettingName;category="bluetooth";constraint=adjAfter]
    (pair|link|connect|set{ }up) [exists;node=boolSettingName;category="bluetooth";constraint=after][exists="keyboard,mouse,headset,headphones,speakers,device";constraint=end]
    pair [d][useSynonym=false]
join [notExists;constraint=end][infers;node=settingMisc;category=wirelessNetwork][infers;node=boolSettingName;category=wifi]
    ;connect to a wireless network
    (join|connect to) [notExists="ask,prompt";constraint=before][exists;node=settingMisc;category=wirelessNetwork;constraint=after]
    ;connect to foo
    (join|connect to) [conf="low"]
    ;set wifi connection to foo network
    {set {wi{-| }fi}} connection to
    join[d]
forget [exists;node=settingMisc;category=wirelessNetwork;constraint=after]
    forget [d]
    delete
    remove

goto [notExists;node=boolSettingName;constraint=before][notExists;node=settingNoun;category=settings;constraint=before][infers;node=settingAttribute;category=ui]
    ;open/show
    display {my} [exists;constraint=start]
    (view|show {me}) {my}
    (bring up|take me to|launch|go{ }to) {my}
    open {up|to} [notExists;node=boolSettingName;category=flashlight]
    ;help me find
    where( is|{'}s| are|'re) [notExists;node=boolSettingName;constraint=before][exists;node=settingMisc;category=wirelessNetwork;constraint=after][exists;node=settingAttribute;category=ui]
    {{can you} help me} find [notExists;node=boolSettingName;constraint=before][exists;node=settingMisc;category=wirelessNetwork;constraint=after][exists;node=settingAttribute;category=ui]
    where( is|{'}s| are|'re) [exists;node=settingAttribute;category=ui;constraint=after]
    {{can you} help me} find [exists;node=settingAttribute;category=ui;constraint=after]
    where( is|{'}s| are|'re) [exists;node=settingNoun;category=settings;constraint=after]
    {{can you} help me} find [exists;node=settingNoun;category=settings;constraint=after]
    where( is|{'}s| are|'re) [exists;node=boolSettingName;constraint=after][notExists;node=settingNoun;category=settings;constraint=before][notExists;node=settingMisc;category=wirelessNetwork]
    {{can you} help me} find [exists;node=boolSettingName;constraint=after][notExists;node=settingNoun;category=settings;constraint=before][notExists;node=settingMisc;category=wirelessNetwork]
