#INCLUDE ../../shared/en/contactReference.inc
#INCLUDE ../../shared/en/handsfreeReference.inc [exists;node=contactReference;constraint=promptTarget]
#INCLUDE ../../shared/en/anyContactReference.inc [exists;node=contact;constraint=promptTarget]

one
    this (contact|person) [saliency=high]
    ; learn to pronounce (that|this) name
    (this | that | the) [exists;node=contactVerb;category="learn name correction,forget name correction";constraint="adjBefore"]
    ; It is pronounced foo
    (it is | it's) [exists;node=contactVerb;category="learn name correction,forget name correction";constraint="adjAfter"]

my
    ;do not match "my" as a contactReference in "read my"
    ;<rdar://problem/9994192> Bad endpoint led Assistant to ask "Which my?"
    my      [notExists;node=contactReference;category="my";constraint=end] [notExists;node=personPlaceName;constraint="adjAfter"]
    my {own}
    for (me|my{ }self) [conf=high] [exists;node=contactNoun;constraint=adjBefore]
