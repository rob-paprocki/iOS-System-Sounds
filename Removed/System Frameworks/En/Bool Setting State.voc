#SUBSTITUTION
READY_FOR
    (going|about) to
    (ready|cleared|preparing) (for|to)

#DICT
on [infers;node=boolSettingVerb;category=set]
    on [notExists="or,and";constraint="adjacent"][exists;node="boolSettingName,boolSettingVerb"]
    on [exists;constraint=start][exists;constraint=end]
    enable{d} [notExists="or,and";constraint="adjacent"]
    (begin|start{ed}) [notExists="or,and";constraint="adjacent"]
    activate{d} [notExists="or,and";constraint="adjacent"]
    use [conf=ml][exists;node=boolSettingName;constraint=adjAfter][notExists="what,why,where,when,how";constraint=start]
    ;wifi
    connect {to} [exists;node=boolSettingName;category="wifi";constraint=after][notExists;node=settingMisc;category="wirelessNetwork";constraint=after]
    ;chatty/volume related settings
    (play|make|unmute) [exists;node=boolSettingName;category="lockSounds,keyboardClicks";constraint=after]
    ;closedCaptioning
    (display|show) [exists;node=boolSettingName;category="closedCaptioning";constraint=after][notExists;node=settingNoun;category=settings]
    ;zoom
    magnify [exists;constraint=start][exists;node=settingMisc;category=screen;constraint=after][infers;node=boolSettingVerb;category=set][infers;node=boolSettingName;category=zoom]
    ;modes
    (enter|go) into [exists;node=boolSettingName;category="airplaneMode,hearingAidMode,guidedAccess,voiceOver,privateBrowsing,assistiveTouch";constraint=adjAfter]
    to [exists;node="boolSettingVerb";category=set;constraint=adjBefore][exists;node=boolSettingName;category="airplaneMode,hearingAidMode,guidedAccess,voiceOver,privateBrowsing,assistiveTouch";constraint=adjAfter]
    to [exists;node="boolSettingVerb";category=set;constraint=before][exists;node=settingMisc;category="iosDevice";constraint=adjBefore][exists;node=boolSettingName;category="airplaneMode,hearingAidMode,guidedAccess,voiceOver,privateBrowsing,assistiveTouch";constraint=adjAfter]
    ;boarding a plane
    e(m|n)plan(e{d}|ing) [infers;node=boolSettingVerb;category=set][infers;node=boolSettingName;category="airplaneMode"]
    (embark|enter|board){ed|ing} [exists;node=boolSettingName;category="airplaneMode";constraint="after"]
    (got|get{ting}) (into|on) [exists;node=boolSettingName;category="airplaneMode";constraint="after"]
    ;the plane is taking off
    ${READY_FOR} take{ }off [infers;node=boolSettingVerb;category=set][infers;node=boolSettingName;category="airplaneMode"]
    taking off [exists;node=boolSettingName;category="airplaneMode";constraint="before"]

off [infers;node=boolSettingVerb;category=set]
    off [notExists="or,and";constraint="adjacent"]
    disable{d} [notExists="or,and";constraint="adjacent"]
    stop{ped} [notExists="or,and";constraint="adjacent"]
    quit [notExists="or,and";constraint="adjacent"]
    deactivate{d} [notExists="or,and";constraint="adjacent"]
    remove{d} [notExists="or,and";constraint="adjacent"]
    shut [exists="down,off";constraint=after]
    unset
    (don't|do not) (use|tell me) [conf=vh][exists;node=boolSettingName;constraint=adjAfter]
    not use [conf=ml][exists;node=boolSettingName;constraint=adjAfter]
    ;wifi
    disconnect {from} [exists;node=boolSettingName;category="wifi";constraint=after]
    drop [exists;node=boolSettingName;category="wifi";constraint=after]
    ;chatty/volume related settings
    (mute|silen(t|ce)) [exists;node=boolSettingName;category="voiceOver,lockSounds,keyboardClicks"]
    ;closedCaptioning
    hidden [exists;node=boolSettingName;category="closedCaptioning,assistiveTouch"]
    hide [exists;node=boolSettingName;category="closedCaptioning,assistiveTouch";constraint=adjAfter]
    ;zoom
    actual size [exists;node=settingMisc;category=screen][infers;node=boolSettingName;category=zoom]
    (minify|unzoom) [exists;constraint=start][exists;node=settingMisc;category=screen;constraint=after][infers;node=boolSettingVerb;category=set][infers;node=boolSettingName;category=zoom]
    ;disembarking the plane
    (disembark|exit|depart){ed|ing} [exists;node=boolSettingName;category="airplaneMode";constraint="after"]
    (left|leaving|leave) [exists;node=boolSettingName;category="airplaneMode";constraint="after"]
    (got|get{ting}) (out|off) [exists;node=boolSettingName;category="airplaneMode";constraint="after"]
    ;the plane landed
    (landed|touched down) [exists;node=boolSettingName;category="airplaneMode";constraint="before"]
    ;trip is over
    flight is (over|done) [infers;node=boolSettingVerb;category=set][infers;node=boolSettingName;category="airplaneMode"]
    ;no more explicit content
    no more [exists;node=boolSettingName]
