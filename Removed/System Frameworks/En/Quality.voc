#SUBSTITUTION

POSITIVE_ADJECTIVE
    awesome
    bad{-| }ass
    cool
    decent
    excellent
    exceptional
    exemplary
    fantastic
    good
    great
    incredible
    magnificent
    nice
    outstanding
    preferred
    super
    terrific
    top{-| }notch
    top{{-| }rated}
    well{-| }liked

NEGATIVE_ADJECTIVE
    abominable
    atrocious
    awful
    bad
    crappy
    dumb
    horrible
    inferior
    lame
    lousy
    shit{ty}
    shoddy
    stupid
    terrible
    unpopular

POSITIVE_SUPERLATIVE
    best {ever|{of} all{-| }time|rated|reviewed}
    coolest
    finest
    greatest
    highest{-| }rated
    most ${POSITIVE_ADJECTIVE}
    nicest

NEGATIVE_SUPERLATIVE
    crappiest
    dumbest
    lamest
    lowest{-| }rated
    most ${NEGATIVE_ADJECTIVE}
    shittiest
    stupidest
    worst {ever|{of} all{-| }time|rated}
    least popular

#DICT