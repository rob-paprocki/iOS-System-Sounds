email
    {the} email {address} [exists;node="contactType,emailType";constraint="promptTarget"][saliency=high]
    {the} email {address} [exists="her,his";constraint="adjBefore"][saliency=high]
    ;capture: "facetime using john's email"
    ;don't capture: "tell dan waters to email marco"
    {the} email {address} [exists;node=person;constraint="adjBefore"][exists="to";constraint="before"][notExists="to";constraint="adjBefore"][notExists="reply";constraint="before"][saliency=high]
    {the} email address