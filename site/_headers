# Cloudflare Pages headers.
#
# The index and the peaks are regenerated whenever the corpus is rebuilt, and
# the page is the only thing that knows which build it wants, so the HTML is
# never cached and everything it names is cached hard.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Fonts are content-addressed by name and will not change under a given file.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Code changes whenever the site is redeployed; revalidate rather than pin.
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate

# The index is large and changes only with a corpus rebuild. A day is a
# reasonable compromise between a stale list and re-downloading 3 MB.
/data/*
  Cache-Control: public, max-age=86400, must-revalidate
